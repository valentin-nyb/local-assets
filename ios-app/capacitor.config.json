{
  "appId": "com.localassets.app",
  "appName": "a™",
  "webDir": "www",
  "server": {
    "url": "https://local-assets.com/dashboard",
    "allowNavigation": ["local-assets.com", "*.local-assets.com"],
    "errorPath": "offline.html"
  },
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#070905",
    "scheme": "a™",
    "limitsNavigationsToAppBoundDomains": false
  },
  "plugins": {
    "SplashScreen": { "launchShowDuration": 600, "backgroundColor": "#070905", "showSpinner": false },
    "StatusBar": { "style": "DARK", "overlaysWebView": true },
    "PushNotifications": { "presentationOptions": ["badge", "sound", "alert"] }
  }
}
