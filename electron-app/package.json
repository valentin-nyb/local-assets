{
  "name": "a-tm",
  "productName": "a™",
  "version": "1.0.1",
  "description": "local / assets for Mac",
  "main": "main.js",
  "author": {
    "name": "local / assets"
  },
  "homepage": "https://local-assets.com",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac dmg --arm64 --x64"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.localassets.app",
    "productName": "a™",
    "copyright": "Copyright © 2026 local / assets LTD",
    "directories": {
      "output": "dist",
      "buildResources": "icons"
    },
    "files": [
      "main.js",
      "offline.html",
      "preload.js",
      "this-mac.js"
    ],
    "protocols": [
      {
        "name": "local / assets sign-in",
        "schemes": [
          "localassets"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "icons/icon.icns",
      "hardenedRuntime": true,
      "darkModeSupport": true,
      "artifactName": "local-assets-${arch}.${ext}",
      "extendInfo": {
        "NSCameraUsageDescription": "a™ streams the cameras you link in Camera Control to your local / assets recordings.",
        "NSMicrophoneUsageDescription": "a™ streams the mixer or microphone you link in Camera Control as your sets' HQ audio.",
        "NSCameraUseContinuityCameraDeviceType": true,
        "LSMultipleInstancesProhibited": true
      },
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist"
    },
    "dmg": {
      "title": "a™",
      "contents": [
        {
          "x": 150,
          "y": 190,
          "type": "file"
        },
        {
          "x": 390,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "extraResources": [
      {
        "from": "vendor/${arch}/ffmpeg",
        "to": "ffmpeg"
      }
    ]
  }
}
